{
  "name": "@exec/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "dev": "node --watch src/dev.ts",
    "test": "node --test src/index.test.ts"
  },
  "dependencies": {
    "effect": "catalog:",
    "@exec/core": "workspace:*",
    "alchemy": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.2"
  }
}
