{
  "name": "solid-yield",
  "description": "Yield components for Solid as a library: strict, typed generator syntax and a runtime interpreter on Solid's public API (no yield compiler).",
  "version": "0.0.0",
  "author": "Dev Agrawal <dev@codemod.com>",
  "license": "MIT",
  "homepage": "https://github.com/devagrawal09/solid-yield#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devagrawal09/solid-yield.git",
    "directory": "packages/yield"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "jsx",
    "NOTICE",
    "package.json"
  ],
  "exports": {
    ".": {
      "worker": {
        "types": "./dist/types/index.d.ts",
        "development": "./dist/server.dev.js",
        "default": "./dist/server.js"
      },
      "browser": {
        "types": "./dist/types/index.d.ts",
        "development": "./dist/yield.dev.js",
        "default": "./dist/yield.js"
      },
      "deno": {
        "types": "./dist/types/index.d.ts",
        "development": "./dist/server.dev.js",
        "default": "./dist/server.js"
      },
      "node": {
        "types": "./dist/types/index.d.ts",
        "development": "./dist/server.dev.js",
        "default": "./dist/server.js"
      },
      "types": "./dist/types/index.d.ts",
      "development": "./dist/yield.dev.js",
      "default": "./dist/yield.js"
    },
    "./internal": {
      "worker": {
        "types": "./dist/types/internal.d.ts",
        "development": "./dist/internal.server.dev.js",
        "default": "./dist/internal.server.js"
      },
      "browser": {
        "types": "./dist/types/internal.d.ts",
        "development": "./dist/internal.dev.js",
        "default": "./dist/internal.js"
      },
      "deno": {
        "types": "./dist/types/internal.d.ts",
        "development": "./dist/internal.server.dev.js",
        "default": "./dist/internal.server.js"
      },
      "node": {
        "types": "./dist/types/internal.d.ts",
        "development": "./dist/internal.server.dev.js",
        "default": "./dist/internal.server.js"
      },
      "types": "./dist/types/internal.d.ts",
      "development": "./dist/internal.dev.js",
      "default": "./dist/internal.js"
    },
    "./h": {
      "types": "./dist/types/h.d.ts",
      "development": "./dist/h.dev.js",
      "default": "./dist/h.js"
    },
    "./jsx-runtime": {
      "types": "./jsx/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsgo -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@solidjs/h": "^2.0.0-rc.11",
    "@solidjs/web": "^2.0.0-rc.11",
    "solid-js": "^2.0.0-rc.11"
  },
  "peerDependenciesMeta": {
    "@solidjs/h": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/h": "2.0.0-rc.14",
    "@solidjs/web": "2.0.0-rc.14",
    "solid-js": "catalog:",
    "esbuild": "0.27.7",
    "csstype": "3.2.3"
  },
  "private": true
}
