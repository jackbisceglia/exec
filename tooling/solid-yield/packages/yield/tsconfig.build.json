{
  "compilerOptions": {
    "outDir": "./dist/types",
    "rootDir": "./src",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "paths": {
      "solid-yield": [
        "./src/index.ts"
      ],
      "solid-yield/internal": [
        "./src/internal.ts"
      ],
      "solid-yield/jsx-runtime": [
        "./jsx/jsx-runtime.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
